---
import { getCollection } from "astro:content";
import LinkCard from "../../components/LinkCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import Sidebar from "../../components/Sidebar.astro";
import ShellLayout from "../../layouts/ShellLayout.astro";
import { COURSE_CONFIG, loadWeeksData } from "../../lib/weekly/weeks";

const lecturas = await getCollection("docs");
const weeksData = await loadWeeksData();

const currentWeek = COURSE_CONFIG.maxCurrentWeek;
const currentWeekData = weeksData[currentWeek];

const groups: Record<
	string,
	{ label: string; entries: typeof lecturas; weekData: any }
> = {};

for (const entry of lecturas) {
	const match = entry.id.match(/semana-(\d+)/);
	if (match) {
		const weekNum = parseInt(match[1]);

		const weekKey = `semana-${weekNum}`;
		if (!groups[weekKey]) {
			groups[weekKey] = {
				label: `Semana ${weekNum}`,
				entries: [],
				weekData: weeksData[weekNum],
			};
		}
		groups[weekKey].entries.push(entry);
	}
}

const orderedGroups = Object.keys(groups).sort((a, b) => {
	const weekA = parseInt(a.replace("semana-", ""));
	const weekB = parseInt(b.replace("semana-", ""));
	return weekA - weekB;
});
---

<ShellLayout title="Documentación del curso" activeTab="documentos">
  <slot name="sidebar" slot="sidebar">
    <Sidebar activeTab="documentos" />
  </slot>
  <div
    class="w-full h-full bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-50 flex flex-col"
    transition:animate="fade"
  >
    <main
      class="w-full px-4 sm:px-6 lg:px-8 pt-4 pb-4 flex-1 overflow-auto min-w-0"
    >
      <div class="space-y-8 max-w-7xl mx-auto">
        <PageHeader
          title="Documentación del curso"
          subtitle="Estructura organizativa y acceso a contenidos por semana."
        />

         <div class="grid md:grid-cols-6 gap-4 p-6"></div>

        {/* Estructura organizativa */}
        <Section title="Estructura de la Documentación">
          <div class="prose dark:prose-invert max-w-none">
            <p>
              La documentación del curso está organizada por semanas para facilitar la navegación y el estudio progresivo. El contenido de cada semana se irá habilitando conforme avance el semestre.
            </p>

            <div class="bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 p-6 my-6">
              <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
                Organización por semanas
              </h3>
              
              <div class="space-y-4">
                <div class="pl-4 border-l-2 border-blue-200 dark:border-blue-800">
                  <p class="mt-2 text-slate-600 dark:text-slate-400">
                    Cada semana consta de una lectura principal y una práctica, permitiendo un aprendizaje progresivo y estructurado.
                  </p>
                </div>

                <div class="grid md:grid-cols-2 gap-4">
                  <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4">
                    <h4 class="font-semibold text-blue-600 dark:text-blue-400 mb-2">Lectura</h4>
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                      Contenido principal con objetivos, explicaciones y ejemplos
                    </p>
                  </div>

                  <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4">
                    <h4 class="font-semibold text-green-600 dark:text-green-400 mb-2">Practica</h4>
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                      Ejercicios prácticos y actividades de aplicación
                    </p>
                  </div>


                </div>
              </div>
            </div>

            <div class="bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800 rounded-lg p-6">
              <h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Componentes interactivos
              </h3>
              <p class="text-sm text-slate-700 dark:text-slate-300">
                Las prácticas y lecturas incluyen componentes educativos como ejercicios interactivos, pistas, y soluciones desplegables para mejorar el aprendizaje.
              </p>
            </div>

                          <div class="grid md:grid-cols-6 gap-4 p-6">
              <div class="col-span-4 col-start-2">
                <LinkCard
                  url={`/semana-${String(currentWeek).padStart(2, '0')}/`}
                  icon="lucide:book-open"
                  text={`Ir a Documentacion de Semana Actual`}
                  description="Ver documentación completa de la semana actual"
                />
              </div>
            </div>

          </div>



        </Section>





      </div>
    </main>
  </div>
</ShellLayout>

<style>
  .gradient-text {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  @media (max-width: 768px) {
    .grid-cols-3 {
      grid-template-columns: 1fr;
    }
  }
</style>