---
import katex from "katex";
import type { GraphConfig, Point } from './types';
import { getTheme, mergeThemes } from './themes';
import { createCoordinateSystem, generateGridRange, formatCoordinate } from './utils';

export interface Props extends GraphConfig {
  points: Point[];
  showLabels?: boolean;
  showGrid?: boolean;
  showGuideLines?: boolean;
  showPointLabels?: boolean;
  maxRange?: { x: number; y: number };
  gridRange?: {
    minX?: number;
    maxX?: number;
    minY?: number;
    maxY?: number;
  };
  className?: string;
  id?: string;
}

const {
  width = 561,
  height = 560,
  padding = 50,
  gridSize = 35,
  theme = 'auto',
  colors: customColors = {},
  animatePoints = true,
  showTooltips = true,
  interactive = true,
  points,
  showLabels = true,
  showGrid = true,
  showGuideLines = true,
  showPointLabels = true,
  maxRange,
  gridRange,
  className = '',
  id,
} = Astro.props;

const colors = mergeThemes(getTheme(theme), customColors);
const coordSystem = createCoordinateSystem(width, height, padding, gridSize);
const { minX: defaultMinX, maxX: defaultMaxX, minY: defaultMinY, maxY: defaultMaxY } = generateGridRange(coordSystem);

const {
  minX: customMinX = defaultMinX,
  maxX: customMaxX = defaultMaxX,
  minY: customMinY = defaultMinY,
  maxY: customMaxY = defaultMaxY
} = gridRange || {};

const verticalLines = Array.from({ length: customMaxX - customMinX + 1 }, (_, i) => customMinX + i);
const horizontalLines = Array.from({ length: customMaxY - customMinY + 1 }, (_, i) => customMinY + i);

const pointsWithPixel = points.map((point, index) => ({
  ...point,
  pixel: coordSystem.gridToPixel(point.x, point.y),
  id: point.id || `point-${index}`,
  color: point.color || colors.primary,
  inBounds: maxRange
    ? point.x >= -maxRange.x && point.x <= maxRange.x && point.y >= -maxRange.y && point.y <= maxRange.y
    : true,
}));

const ariaLabel = `Sistema cartesiano con ${points.length} punto${points.length !== 1 ? 's' : ''}: ${points
  .map((p) => `(${formatCoordinate(p.x)}, ${formatCoordinate(p.y)})`)
  .join(', ')}`;

const description = `Sistema de coordenadas cartesiano con ${points.length} punto${points.length !== 1 ? 's' : ''}.`;

const svgId = id || 'cartesian-system';
---

<style>
  .cartesian-container {
    display: inline-block;
    position: relative;
  }

  .point-circle {
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .point-circle:hover {
    r: 7;
    filter: brightness(1.1);
  }

  .point-circle:focus {
    outline: none;
  }

  .point-ring {
    transition: all 0.3s ease;
  }

  .tooltip-group {
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .tooltip-rect {
    rx: 4;
    ry: 4;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .animate-pulse {
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .animate-spin-slow {
    transform-origin: center;
    animation: spin-slow 3s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .point-circle,
    .point-ring,
    .tooltip-group {
      transition: none;
    }

    .animate-pulse,
    .animate-spin-slow {
      animation: none;
    }
  }

  .katex-wrapper {
    font-size: 14px;
    line-height: 1.2;
  }

  :global(.katex-wrapper .katex) {
    font-size: 1em;
  }

  :global(.katex-wrapper .katex-html) {
    color: inherit;
  }

  :global(.katex-wrapper .katex-mathml) {
    color: inherit;
  }

  :global(.katex-wrapper .katex-mathml .mtext) {
    color: inherit;
  }

  :global(.katex-wrapper .katex-mathml .msupsub) {
    color: inherit;
  }

  .axis-label :global(.katex) {
    color: var(--axis-color, #374151) !important;
  }

  .axis-label :global(.katex .katex) {
    color: var(--axis-color, #374151) !important;
  }

  .tooltip-content :global(.katex .katex) {
    color: var(--tooltipText-color, rgb(8, 8, 8));
  }

  .katex-wrapper {
    font-size: 14px;
    line-height: 1.2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--text-color, #111827);
  }

  .point-label :global(.katex) {
    font-size: 13px;
    font-weight: 500;
  }

  .tooltip-content :global(.katex) {
    font-size: 13px;
    font-weight: 500;
    color: var(--tooltipText-color, rgb(8, 8, 8));
  }

  .axis-label :global(.katex) {
    font-size: 15px;
    font-weight: bold;
    color: var(--axis-color, #374151);
  }

  .grid-number {
    font-size: 12px;
    font-weight: 400;
  }

  @media (max-width: 768px) {
    :global(.katex-wrapper) {
      font-size: 18px;
      line-height: 1.3;
    }

    :global(.katex-wrapper .katex) {
      font-size: 1em;
    }

    .point-label :global(.katex) {
      font-size: 16px;
      font-weight: 600;
    }

    .tooltip-content :global(.katex) {
      font-size: 16px;
      font-weight: 600;
      color: var(--tooltipText-color, rgb(8, 8, 8));
    }

    .axis-label :global(.katex) {
      font-size: 18px;
      font-weight: bold;
    }

    .grid-number {
      font-size: 14px;
      font-weight: 500;
    }
  }

  @media (max-width: 480px) {
    :global(.katex-wrapper) {
      font-size: 20px;
      line-height: 1.4;
    }

    :global(.katex-wrapper .katex) {
      font-size: 1em;
    }

    .point-label :global(.katex) {
      font-size: 18px;
      font-weight: 600;
    }

    .tooltip-content :global(.katex) {
      font-size: 18px;
      font-weight: 600;
      color: var(--tooltipText-color, rgb(8, 8, 8));
    }

    .axis-label :global(.katex) {
      font-size: 20px;
      font-weight: bold;
    }

    .grid-number {
      font-size: 16px;
      font-weight: 600;
    }
  }
</style>

<div class={`cartesian-container ${className}`}>
  <svg
    id={svgId}
    width={width}
    height={height}
    viewBox={`0 0 ${width} ${height}`}
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={`Sistema cartesiano con ${points.length} punto${points.length !== 1 ? 's' : ''}`}
    aria-describedby={`${svgId}-description`}
    focusable={interactive ? "true" : "false"}
    tabindex={interactive ? 0 : -1}
    class="cartesian-svg"
  >
    <title>{description}</title>
    <desc id={`${svgId}-description`}>{description}</desc>

    <rect width={width} height={height} fill={colors.background}/>

    {showGrid && (
      <g aria-label="Cuadrícula del sistema de coordenadas">
        {verticalLines.map((gridX) => {
          const pixelX = coordSystem.gridToPixel(gridX, 0).x;
          const isAxis = gridX === 0;
          return (
            <line
              x1={pixelX}
              y1={padding}
              x2={pixelX}
              y2={height - padding}
              stroke={isAxis ? colors.axis : colors.grid}
              stroke-width={isAxis ? "2" : "1"}
              stroke-dasharray={isAxis ? "none" : "4 2"}
              aria-hidden="true"
            />
          );
        })}

        {horizontalLines.map((gridY) => {
          const pixelY = coordSystem.gridToPixel(0, gridY).y;
          const isAxis = gridY === 0;
          return (
            <line
              x1={padding}
              y1={pixelY}
              x2={width - padding}
              y2={pixelY}
              stroke={isAxis ? colors.axis : colors.grid}
              stroke-width={isAxis ? "2" : "1"}
              stroke-dasharray={isAxis ? "none" : "4 2"}
              aria-hidden="true"
            />
          );
        })}
      </g>
    )}

    {pointsWithPixel.map((pointData) => (
      <g>
        {showGuideLines && (
          <g aria-hidden="true">
            <line
              x1={pointData.pixel.x}
              y1={coordSystem.originY}
              x2={pointData.pixel.x}
              y2={pointData.pixel.y}
              stroke={colors.guide}
              stroke-width="1"
              stroke-dasharray="4 4"
            />
            <line
              x1={coordSystem.originX}
              y1={pointData.pixel.y}
              x2={pointData.pixel.x}
              y2={pointData.pixel.y}
              stroke={colors.guide}
              stroke-width="1"
              stroke-dasharray="4 4"
            />
          </g>
        )}

        {!pointData.inBounds && (
          <g aria-label={`Punto fuera de rango: (${formatCoordinate(pointData.x)}, ${formatCoordinate(pointData.y)})`}>
            <circle
              cx={pointData.pixel.x}
              cy={pointData.pixel.y}
              r="12"
              fill="none"
              stroke={colors.warning}
              stroke-width="2"
              stroke-dasharray="4 4"
              class={animatePoints ? 'animate-spin-slow' : ''}
            />
            <text
              x={pointData.pixel.x}
              y={pointData.pixel.y - 18}
              fill={colors.warning}
              font-size="10"
              text-anchor="middle"
              font-weight="bold"
            >
              Fuera de rango
            </text>
          </g>
        )}

        <g class="point-group">
          <circle
            cx={pointData.pixel.x}
            cy={pointData.pixel.y}
            r="10"
            fill={pointData.color}
            opacity="0.2"
            class={animatePoints ? 'point-ring animate-pulse' : 'point-ring'}
            aria-hidden="true"
          />
          <circle
            cx={pointData.pixel.x}
            cy={pointData.pixel.y}
            r="5.5"
            fill={pointData.color}
            class="point-circle"
            aria-label={`Coordenadas: x = ${formatCoordinate(pointData.x)}, y = ${formatCoordinate(pointData.y)}`}
            tabindex={interactive ? 0 : -1}
            data-point-id={pointData.id}
            data-coordinates={`(${formatCoordinate(pointData.x)}, ${formatCoordinate(pointData.y)})`}
          />
          {showPointLabels && pointData.label && (
            <foreignObject
              x={pointData.pixel.x - 20}
              y={pointData.pixel.y - 35}
              width={60}
              height={40}
              aria-hidden="true"
            >
              <div class="katex-wrapper point-label" set:html={katex.renderToString(pointData.label, { displayMode: false })} />
            </foreignObject>
          )}
        </g>

        {showTooltips && interactive && (
          <g
            class="tooltip-group opacity-0"
            aria-hidden="true"
          >
            
            <foreignObject
              x={pointData.pixel.x - 50}
              y={pointData.pixel.y - 40}
              width={100}
              height={35}
            >
              <div class="katex-wrapper tooltip-content " set:html={katex.renderToString(`(${formatCoordinate(pointData.x)}, ${formatCoordinate(pointData.y)})`, { displayMode: false })} />
            </foreignObject>
          </g>
        )}
      </g>
    ))}

    {showLabels && (
      <g
        font-family="Arial, sans-serif"
        font-size="12"
        fill={colors.text}
        text-anchor="middle"
        class="grid-labels"
        aria-label="Etiquetas de los ejes y números"
      >
        {verticalLines
          .filter((gridX) => gridX !== 0)
          .map((gridX) => (
            <text
              x={coordSystem.gridToPixel(gridX, 0).x}
              y={coordSystem.originY + 20}
              class="grid-number"
            >
              {gridX}
            </text>
          ))}

        {horizontalLines
          .filter((gridY) => gridY !== 0)
          .map((gridY) => (
            <text
              x={coordSystem.originX - 12}
              y={coordSystem.gridToPixel(0, gridY).y + 4}
              text-anchor="end"
              class="grid-number"
            >
              {gridY}
            </text>
          ))}
      </g>
    )}

    {showLabels && (
      <g
        font-family="Arial, sans-serif"
        font-size="14"
        font-weight="bold"
        aria-label="Etiquetas de los ejes y números"
      >
        <foreignObject x={width - padding - 10} y={coordSystem.originY - 20} width={40} height={40}>
          <div class="katex-wrapper axis-label" set:html={katex.renderToString("x", { displayMode: false })} />
        </foreignObject>
        <foreignObject x={coordSystem.originX-20} y={padding - 30} width={40} height={40}>
          <div class="katex-wrapper axis-label" set:html={katex.renderToString("y", { displayMode: false })} />
        </foreignObject>
      </g>
    )}
  </svg>
</div>

<script define:vars={{ svgId, interactive }}>
  function initializeCartesianSystem() {
    if (!interactive) return;

    const svg = document.getElementById(svgId);
    if (!svg) return;

    const pointCircles = svg.querySelectorAll('.point-circle');
    const tooltipGroups = svg.querySelectorAll('.tooltip-group');

    function showTooltip(pointId) {
      const pointCircle = svg.querySelector(`[data-point-id="${pointId}"]`);
      const tooltipGroup = pointCircle?.closest('.point-group')?.querySelector('.tooltip-group');

      if (tooltipGroup) {
        tooltipGroup.classList.remove('opacity-0');
        tooltipGroup.classList.add('opacity-100');
      }
    }

    function hideTooltip(pointId) {
      const pointCircle = svg.querySelector(`[data-point-id="${pointId}"]`);
      const tooltipGroup = pointCircle?.closest('.point-group')?.querySelector('.tooltip-group');

      if (tooltipGroup) {
        tooltipGroup.classList.remove('opacity-100');
        tooltipGroup.classList.add('opacity-0');
      }
    }

    function hideAllTooltips() {
      tooltipGroups.forEach(group => {
        group.classList.remove('opacity-100');
        group.classList.add('opacity-0');
      });
    }

    pointCircles.forEach(circle => {
      const pointId = circle.getAttribute('data-point-id');
      if (!pointId) return;

      circle.addEventListener('mouseenter', () => showTooltip(pointId));
      circle.addEventListener('mouseleave', () => hideTooltip(pointId));
      circle.addEventListener('focus', () => showTooltip(pointId));
      circle.addEventListener('blur', () => hideTooltip(pointId));

      circle.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const coordinates = circle.getAttribute('data-coordinates');
          if (coordinates) {
            alert(`Coordenadas: ${coordinates}`);
          }
        }
      });
    });

    svg.addEventListener('mouseleave', hideAllTooltips);
  }

  initializeCartesianSystem();
</script>
