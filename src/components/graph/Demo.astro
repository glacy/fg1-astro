---
import { SistemaCartesiano, SistemaPolar } from './index';

const cartesianPoints = [
  { x: 2, y: 3, label: 'A_1', color: '#EF4444' },
  { x: -1, y: 2, label: 'A_2', color: '#3B82F6' },
  { x: 0, y: -2, label: 'A_3', color: '#10B981' },
  { x: 3, y: 0, label: 'A_4', color: '#F59E0B' }
];

const polarPoints = [
  { r: 3, theta: 56.3, label: 'P_1', color: '#EF4444' },
  { r: 2.24, theta: 116.6, label: 'P_2', color: '#3B82F6' },
  { r: 2, theta: 270, label: 'P_3', color: '#10B981' },
  { r: 3, theta: 0, label: 'P_4', color: '#F59E0B' }
];

const polarRadians = [
  { r: 2, theta: Math.PI / 4, label: '\\frac{\\pi}{4}', color: '#EF4444' },
  { r: 3, theta: Math.PI / 2, label: '\\frac{\\pi}{2}', color: '#3B82F6' },
  { r: 2, theta: Math.PI, label: '\\pi', color: '#10B981' },
  { r: 1.5, theta: (3 * Math.PI) / 2, label: '\\frac{3\\pi}{2}', color: '#F59E0B' }
];

const polarWithOffset = [
  { r: 3, theta: 45, label: 'P_1', color: '#EF4444', tooltipOffset: { x: 30, y: -40 } },
  { r: 2, theta: 120, label: 'P_2', color: '#3B82F6', tooltipOffset: { x: -80, y: 20 } },
  { r: 4, theta: 270, label: 'P_3', color: '#10B981' }
];
---

<div class="space-y-12 p-8">
  <header>
    <h1 class="text-3xl font-bold mb-2">Demo: Sistemas de Coordenadas</h1>
    <p class="text-gray-600">Componentes interactivos y accesibles para visualizar sistemas cartesianos y polares</p>
  </header>

  <!-- Sistema Cartesiano Básico -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Sistema Cartesiano</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="text-lg font-medium">Múltiples Puntos</h3>
        <SistemaCartesiano
          points={cartesianPoints}
          className="w-full"
        />
        <p class="text-sm text-gray-500">Hover sobre los puntos para ver coordenadas LaTeX $(x, y)$</p>
      </div>

      <div class="space-y-4">
        <h3 class="text-lg font-medium">Con Validación de Límites</h3>
        <SistemaCartesiano
          points={[
            { x: 2, y: 3, label: 'Dentro', color: '#10B981' },
            { x: 12, y: 8, label: 'Fuera', color: '#EF4444' }
          ]}
          maxRange={{ x: 10, y: 10 }}
          colors={{
            warning: '#F59E0B',
          }}
          className="w-full"
        />
        <p class="text-sm text-gray-500">El punto fuera de rango muestra un indicador visual</p>
      </div>
    </div>
  </section>

  <!-- Sistema Polar Básico -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Sistema Polar</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="text-lg font-medium">Ángulos en Grados</h3>
        <SistemaPolar
          points={polarPoints}
          className="w-full"
        />
        <p class="text-sm text-gray-500">Incluye línea radial, etiquetas LaTeX y tooltips $r=3, \theta=45°$</p>
      </div>

      <div class="space-y-4">
        <h3 class="text-lg font-medium">Ángulos en Radianes</h3>
        <SistemaPolar
          points={polarRadians}
          angleInDegrees={false}
          showThetaLabel={false}
          className="w-full"
        />
        <p class="text-sm text-gray-500">Ángulos expresados en notación de π</p>
      </div>

      <div class="space-y-4">
        <h3 class="text-lg font-medium">Offset de Tooltip Personalizado</h3>
        <SistemaPolar
          points={polarWithOffset}
          className="w-full"
        />
        <p class="text-sm text-gray-500">Cada punto tiene posición de tooltip ajustada vía <code class="bg-gray-100 px-1 rounded">tooltipOffset</code></p>
      </div>
    </div>
  </section>

  <!-- Personalización -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Personalización</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="text-lg font-medium">Colores Personalizados</h3>
        <SistemaCartesiano
          points={[
            { x: 1, y: 1, label: 'P_1', color: '#FF6B6B' },
            { x: 2, y: 2, label: 'P_2', color: '#4ECDC4' },
            { x: -1, y: 2, label: 'P_3', color: '#FFE66D' }
          ]}
          colors={{
            primary: '#FF6B6B',
            secondary: '#4ECDC4',
            guide: '#A0A0A0',
            tooltip: 'rgba(0,0,0,0.9)',
          }}
          className="w-full"
        />
      </div>

      <div class="space-y-4">
        <h3 class="text-lg font-medium">Sin Interactividad</h3>
        <SistemaCartesiano
          points={[
            { x: 2, y: 3, label: 'B_1', color: '#3B82F6' },
            { x: -1, y: 2, label: 'B_2', color: '#10B981' }
          ]}
          interactive={false}
          showTooltips={false}
          animatePoints={false}
          className="w-full"
        />
        <p class="text-sm text-gray-500">Gráfico estático sin tooltips ni animaciones</p>
      </div>
    </div>
  </section>

  <!-- Comparación -->
  <section>
    <h2 class="text-2xl font-semibold mb-4">Comparación: Mismo Punto</h2>
    <p class="text-gray-600 mb-6">Visualización del mismo punto (2, 3) en ambos sistemas</p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="text-lg font-medium">Cartesiano: (2, 3)</h3>
        <SistemaCartesiano
          points={[{ x: 2, y: 3, label: 'C_1', color: '#8B5CF6' }]}
          className="w-full"
        />
      </div>

      <div class="space-y-4">
        <h3 class="text-lg font-medium">Polar: (r≈3.61, θ≈56.3°)</h3>
        <SistemaPolar
          points={[{ r: 3.606, theta: 56.31, label: 'C_1', color: '#8B5CF6' }]}
          className="w-full"
        />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6">
    <h2 class="text-2xl font-semibold mb-4">Características</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="space-y-2">
        <h3 class="font-semibold text-green-600">✅ Multi-puntos</h3>
        <p class="text-sm text-gray-600">Soporta múltiples puntos con etiquetas y colores personalizados</p>
      </div>
      <div class="space-y-2">
        <h3 class="font-semibold text-blue-600">✅ Tema Automático</h3>
        <p class="text-sm text-gray-600">Detecta automáticamente light/dark mode del sistema</p>
      </div>
      <div class="space-y-2">
        <h3 class="font-semibold text-purple-600">✅ Accesibilidad</h3>
        <p class="text-sm text-gray-600">Screen readers, navegación por teclado, contraste WCAG</p>
      </div>
      <div class="space-y-2">
        <h3 class="font-semibold text-orange-600">✅ Interactividad</h3>
        <p class="text-sm text-gray-600">Tooltips, hover effects, focus states</p>
      </div>
      <div class="space-y-2">
        <h3 class="font-semibold text-pink-600">✅ Validación</h3>
        <p class="text-sm text-gray-600">Indica cuando los puntos están fuera del rango visible</p>
      </div>
      <div class="space-y-2">
        <h3 class="font-semibold text-cyan-600">✅ Math Rendering</h3>
        <p class="text-sm text-gray-600">KaTeX para etiquetas LaTeX ($x$, $y$, $r$, etiquetas de puntos)</p>
      </div>
    </div>
  </section>

  <footer class="text-center text-gray-500 text-sm mt-8">
    <p>Los componentes respetan prefers-reduced-motion y son totalmente responsive</p>
  </footer>
</div>

<style>
  /* Estilos básicos para la demo */
  h1 {
    color: #1f2937;
  }

  h2 {
    color: #374151;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
  }

  h3 {
    color: #4b5563;
  }

  @media (prefers-color-scheme: dark) {
    h1, h2, h3 {
      color: #f9fafb;
    }

    h2 {
      border-bottom-color: #374151;
    }

    .text-gray-600 {
      color: #d1d5db;
    }

    .text-gray-500 {
      color: #9ca3af;
    }

    .bg-gray-50 {
      background-color: #374151;
    }
  }
</style>
