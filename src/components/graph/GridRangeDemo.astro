---
import { SistemaCartesiano } from './index';

const defaultPoints = [
  { x: 2, y: 3, label: 'A', color: '#EF4444' },
  { x: -1, y: 2, label: 'B', color: '#3B82F6' },
  { x: 0, y: -2, label: 'C', color: '#10B981' }
];
---

<div class="space-y-8 p-8">
  <header>
    <h1 class="text-2xl font-bold mb-2">Demo: Control del Rango de la Cuadrícula</h1>
    <p class="text-gray-600">Ejemplos de cómo controlar las líneas del grid usando la prop `gridRange`</p>
  </header>

  <!-- Grid por defecto (-7 a +7) -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Grid por Defecto</h2>
    <p class="text-sm text-gray-500 mb-4">Dibuja líneas desde -7 hasta +7 en ambos ejes</p>
    <SistemaCartesiano
      points={defaultPoints}
      className="border border-gray-300"
    />
  </section>

  <!-- Grid personalizado (-6 a +6) -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Grid Personalizado (-6 a +6)</h2>
    <p class="text-sm text-gray-500 mb-4">Excluye las líneas en -7 y +7 usando gridRange</p>
    <SistemaCartesiano
      points={defaultPoints}
      gridRange={{ minX: -6, maxX: 6, minY: -6, maxY: 6 }}
      className="border border-gray-300"
    />
  </section>

  <!-- Solo primer cuadrante -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Solo Primer Cuadrante</h2>
    <p class="text-sm text-gray-500 mb-4">Solo líneas positivas desde 0 hasta +5</p>
    <SistemaCartesiano
      points={[
        { x: 2, y: 3, label: 'A', color: '#EF4444' },
        { x: 1, y: 1, label: 'B', color: '#3B82F6' },
        { x: 4, y: 2, label: 'C', color: '#10B981' }
      ]}
      gridRange={{ minX: 0, maxX: 5, minY: 0, maxY: 5 }}
      className="border border-gray-300"
    />
  </section>

  <!-- Grid asimétrico -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Grid Asimétrico</h2>
    <p class="text-sm text-gray-500 mb-4">Diferentes rangos para X (-5 a +5) y Y (-3 a +3)</p>
    <SistemaCartesiano
      points={defaultPoints}
      gridRange={{ minX: -5, maxX: 5, minY: -3, maxY: 3 }}
      className="border border-gray-300"
    />
  </section>

  <!-- Grid solo positivo en X, completo en Y -->
  <section>
    <h2 class="text-xl font-semibold mb-4">Grid Mixto</h2>
    <p class="text-sm text-gray-500 mb-4">Solo positivo en X (0 a +6), completo en Y (-6 a +6)</p>
    <SistemaCartesiano
      points={[
        { x: 2, y: 3, label: 'A', color: '#EF4444' },
        { x: 4, y: -2, label: 'B', color: '#3B82F6' }
      ]}
      gridRange={{ minX: 0, maxX: 6, minY: -6, maxY: 6 }}
      className="border border-gray-300"
    />
  </section>
</div>

<style>
  h1 {
    color: #1f2937;
  }

  h2 {
    color: #374151;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
  }

  @media (prefers-color-scheme: dark) {
    h1, h2 {
      color: #f9fafb;
    }

    h2 {
      border-bottom-color: #374151;
    }

    .text-gray-600 {
      color: #d1d5db;
    }

    .text-gray-500 {
      color: #9ca3af;
    }

    .border-gray-300 {
      border-color: #4b5563;
    }
  }
</style>
